# ── Renewal Desk Linux Connector ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#
# Get API_KEY, GYM_ID from the bridge pairing flow in Renewal Desk.
# Get DEVICE_SERIAL from the biometric terminal's network settings screen.

# ── Device ───────────────────────────────────────────────────────────────────
DEVICE_IP=192.168.1.201
DEVICE_PORT=4370
DEVICE_COMM_KEY=0

# ── Cloud API ────────────────────────────────────────────────────────────────
API_BASE_URL=https://your-app.up.railway.app
API_KEY=your-bridge-api-key-from-pairing
GYM_ID=your-gym-public-id-from-pairing
DEVICE_SERIAL=your-terminal-serial-number

# ── Intervals (seconds) ─────────────────────────────────────────────────────
HEARTBEAT_INTERVAL=30
COMMAND_POLL_INTERVAL=5
ATTENDANCE_FLUSH_INTERVAL=60

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# LOG_FILE=connector.log
