# ==============================================================================
# Renewal Desk Mobile App (Android / iOS) — Environment Configuration
# Copy this file to .env in renewal-desk-android/
#
# NOTE: Only EXPO_PUBLIC_* variables are embedded into the client application.
# NEVER put private server secrets, database credentials, or secret keys here.
# ==============================================================================

# Application Runtime Environment: production | staging | development
EXPO_PUBLIC_APP_ENV=production

# Production Backend API URL (must use HTTPS in production)
EXPO_PUBLIC_API_BASE_URL=https://gym-production-910c.up.railway.app

# Google OAuth Android Client ID (generated in Google Cloud Console with app SHA-1 fingerprint)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=126496413976-0fiqve1n9eacie14ktam8vbviqt6447g.apps.googleusercontent.com

# Google OAuth Web / Server Client ID (matches GOOGLE_OAUTH_CLIENT_ID on the backend)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=126496413976-4clljk154ngoiofoelvuglvm214gibqe.apps.googleusercontent.com

# EAS Build Configuration: Suppress Expo Go development warning on cloud builds
EAS_BUILD_NO_EXPO_GO_WARNING=true
