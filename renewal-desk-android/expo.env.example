# ==============================================================================
# Renewal Desk Mobile App — Expo & EAS Environment Variables
#
# HOW EXPO HANDLES VARIABLES:
# In Expo SDK 49+, any environment variable prefixed with `EXPO_PUBLIC_` is
# automatically inlined into the client bundle at build time.
#
# THREE WAYS TO SET THEM IN EXPO:
# 1. Local file: Copy this to `renewal-desk-android/.env`
# 2. In `eas.json`: Defined under `build.<profile>.env` (already configured)
# 3. Expo Dashboard: https://expo.dev/accounts/bharath1818/projects/renewal-desk-android/variables
# ==============================================================================

# ─── Application Runtime Environment ──────────────────────────────────────────
# Values: 'production' | 'staging' | 'development'
# In 'production', HTTP URLs are blocked and strict TLS/HTTPS is enforced.
EXPO_PUBLIC_APP_ENV=production

# ─── Backend API URL ───────────────────────────────────────────────────────────
# Must point to your live HTTPS backend (no trailing slash).
# In production, this connects to your Railway deployment.
EXPO_PUBLIC_API_BASE_URL=https://gym-production-910c.up.railway.app

# ─── Google OAuth Client IDs ──────────────────────────────────────────────────
# 1. Android Client ID: Configured in Google Cloud Console with your app's
#    package name (`online.revorax.renewaldesk`) and SHA-1 certificate fingerprint.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=126496413976-0fiqve1n9eacie14ktam8vbviqt6447g.apps.googleusercontent.com

# 2. Web / Server Client ID: Configured in Google Cloud Console as a "Web application".
#    Used by the backend to verify ID tokens during mobile sign-in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=126496413976-4clljk154ngoiofoelvuglvm214gibqe.apps.googleusercontent.com

# ─── EAS Cloud Build Settings ─────────────────────────────────────────────────
# Suppresses the Expo Go development client warning during EAS production builds.
EAS_BUILD_NO_EXPO_GO_WARNING=true
