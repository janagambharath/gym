# ==============================================================================
# Renewal Desk — Railway Production Environment Variables (Raw Editor Format)
#
# HOW TO USE IN RAILWAY:
# 1. Open your Railway Project dashboard: https://railway.app
# 2. Click on your Flask web service (e.g., "gym-production-910c")
# 3. Go to the "Variables" tab
# 4. Click "Raw Editor" (top right button)
# 5. Paste the variables below, replace the placeholder secrets, and click "Update"
#
# NOTE: If you have attached PostgreSQL and Redis services in Railway,
# DATABASE_URL and REDIS_URL are automatically populated by Railway.
# ==============================================================================

# Core Flask & Production
FLASK_ENV=production
SECRET_KEY=generate_with_python_secrets_token_hex_32
PUBLIC_BASE_URL=https://gym-production-910c.up.railway.app
SESSION_COOKIE_SECURE=true
LOG_LEVEL=INFO

# Database & Redis (Automatic in Railway if Postgres & Redis plugins are added)
# If using Railway's attached PostgreSQL plugin: ${{Postgres.DATABASE_URL}}
DATABASE_URL=${{Postgres.DATABASE_URL}}
# If using Railway's attached Redis plugin: ${{Redis.REDIS_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# Gunicorn Production Tuning
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=2000
GUNICORN_MAX_REQUESTS_JITTER=200

# Automated Reminders & Cron Scheduler
ENABLE_SCHEDULER=true
REMINDER_DAYS_BEFORE=7,3,1,0
REMINDER_JOB_MINUTES=1440
DEFAULT_GYM_TIMEZONE=Asia/Kolkata

# Biometric Access Bridge Queue
BRIDGE_COMMAND_LEASE_SECONDS=120
BRIDGE_COMMAND_BATCH_SIZE=25
BRIDGE_COMMAND_RETRY_SECONDS=300
BRIDGE_COMMAND_MAX_EXECUTION_ATTEMPTS=5

# File & Storage
STORAGE_BACKEND=local
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880

# WhatsApp Cloud API & Webhook
WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=your_meta_permanent_system_user_token
WHATSAPP_API_VERSION=v20.0
WHATSAPP_VERIFY_TOKEN=your_random_webhook_verify_token
WHATSAPP_WEBHOOK_SECRET=your_meta_app_secret
WHATSAPP_REMINDER_TEMPLATE_NAME=membership_renewal_reminder_01
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=en_US
WHATSAPP_REMINDER_TEMPLATE_BODY_PARAMS=member_name,gym_name,expiry_date,payment_upi_id
META_APP_ID=1711816793132513
META_CONFIG_ID=1075973911551679

# Mobile REST API & JWT Authentication
MOBILE_API_ENABLED=true
MOBILE_API_TOKEN_SECRET=generate_with_python_secrets_token_hex_32
MOBILE_API_ACCESS_TOKEN_MINUTES=15
MOBILE_API_REFRESH_TOKEN_DAYS=30

# Google OAuth (Mobile Sign-In Verification)
GOOGLE_OAUTH_CLIENT_ID=126496413976-4clljk154ngoiofoelvuglvm214gibqe.apps.googleusercontent.com
GOOGLE_OAUTH_ANDROID_CLIENT_ID=126496413976-0fiqve1n9eacie14ktam8vbviqt6447g.apps.googleusercontent.com

# Initial Superadmin & Seed Passwords
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change_to_a_strong_admin_password
DEMO_OWNER_PASSWORD=change_to_a_strong_demo_password

# WhatsApp AI Receptionist (OpenRouter Multi-Tier)
BOT_AI_ENABLED=true
BOT_AI_PROVIDER=openrouter
BOT_AI_BASE_URL=https://openrouter.ai/api/v1
BOT_AI_API_KEY=sk-or-v1-your_openrouter_api_key
BOT_AI_MODEL_PRIMARY=meta-llama/llama-3.3-70b-instruct:free
BOT_AI_MODEL_FALLBACK_1=google/gemini-2.0-flash-001
BOT_AI_MODEL_FALLBACK_2=mistralai/mistral-7b-instruct:free
BOT_AI_TIMEOUT_SECONDS=10
BOT_AI_MAX_TOKENS=450

# Multimodal Document Scanner & Vision
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
OPENROUTER_VISION_MODEL_PRIMARY=google/gemini-2.0-flash-001
OPENROUTER_VISION_MODEL_FALLBACK=qwen/qwen-2.5-vl-72b-instruct:free
DOCUMENT_SCAN_MAX_IMAGES=5
DOCUMENT_SCAN_MAX_IMAGE_SIZE_MB=5
DOCUMENT_SCAN_TIMEOUT_SECONDS=25
