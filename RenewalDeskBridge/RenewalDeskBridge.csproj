<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RenewalDeskBridge</AssemblyName>
    <RootNamespace>RenewalDeskBridge</RootNamespace>
    <ApplicationIcon></ApplicationIcon>
    <!-- zkemkeeper.dll is a 64-bit COM server; register SDK/x64/zkemkeeper.dll before building. -->
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- BridgeConfig loads this file from beside the executable at runtime. -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    The .NET SDK's cross-platform MSBuild cannot run ResolveComReference (MSB4803).
    Its build therefore consumes the SDK-generated interop assembly below.  Windows
    MSBuild continues to resolve this actual type-library reference from the registered
    x64 COM server, so Visual Studio users get the standard COM-reference behaviour.
  -->
  <ItemGroup Condition="'$(MSBuildRuntimeType)' == 'Core'">
    <Reference Include="Interop.zkemkeeper">
      <HintPath>Interop\Interop.zkemkeeper.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- GUID and version verified from the supplied eSSL 6.3.1.55 SDK demo projects. -->
  <ItemGroup Condition="'$(MSBuildRuntimeType)' != 'Core'">
    <COMReference Include="zkemkeeper">
      <Guid>{FE9DED34-E159-408E-8490-B720A5E632C7}</Guid>
      <VersionMajor>1</VersionMajor>
      <VersionMinor>0</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>false</Isolated>
    </COMReference>
  </ItemGroup>

</Project>
