# ==============================================================================
# Renewal Desk — Production & Development Environment Configuration
# Copy this file to .env and replace placeholder values with your real configuration.
# DO NOT commit real .env files with secrets into version control.
# ==============================================================================

# ─── Core Flask & Server ───────────────────────────────────────────────────────
# Options: production | development | testing
FLASK_ENV=production

# 64-character secret key for cookie signing and cryptographic operations.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-64-character-hex-string

# PostgreSQL connection URI (use postgresql:// for production, sqlite for local dev)
# Example: postgresql://username:password@hostname:5432/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gym_saas

# Public root URL where this application is hosted (no trailing slash)
PUBLIC_BASE_URL=https://gym-production-910c.up.railway.app

# Server log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Sessions & Cookie Security ───────────────────────────────────────────────
# Enforces Secure flag on session cookies (must be true in production HTTPS)
SESSION_COOKIE_SECURE=true

# ─── Automated Reminders & Scheduler ──────────────────────────────────────────
# Enable in-process APScheduler background job runner
ENABLE_SCHEDULER=true

# Comma-separated days before expiry to trigger automated renewal reminders
# e.g., 7 days before, 3 days before, 1 day before, and 0 (on day of expiry)
REMINDER_DAYS_BEFORE=7,3,1,0

# Frequency of the reminder job execution in minutes (1440 = 24 hours)
REMINDER_JOB_MINUTES=1440

# Default timezone for gym operational schedules and date calculations
DEFAULT_GYM_TIMEZONE=Asia/Kolkata

# ─── Biometric Access Bridge ──────────────────────────────────────────────────
# Configuration for local desktop bridge polling and device command dispatch.
BRIDGE_COMMAND_LEASE_SECONDS=120
BRIDGE_COMMAND_BATCH_SIZE=25
BRIDGE_COMMAND_RETRY_SECONDS=300
BRIDGE_COMMAND_MAX_EXECUTION_ATTEMPTS=5

# ─── File & Image Storage ─────────────────────────────────────────────────────
# Storage backend: 'local' for filesystem uploads, 's3' for AWS S3
STORAGE_BACKEND=local
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880

# AWS S3 Configuration (only required if STORAGE_BACKEND=s3)
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=ap-south-1
AWS_S3_PUBLIC_BASE_URL=

# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
# Master toggle for WhatsApp messaging
WHATSAPP_ENABLED=true

# Meta WhatsApp Business Cloud API Permanent System User Access Token
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here

# Graph API Version (e.g., v20.0, v21.0)
WHATSAPP_API_VERSION=v20.0

# Random string configured in Meta App Dashboard > WhatsApp > Configuration > Verify token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# Meta App Secret used to verify X-Hub-Signature-256 HMAC on incoming webhooks
WHATSAPP_WEBHOOK_SECRET=your_meta_app_secret_here

# Meta Approved Transactional Template for automated renewal reminders
WHATSAPP_REMINDER_TEMPLATE_NAME=membership_renewal_reminder_01
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=en_US
WHATSAPP_REMINDER_TEMPLATE_BODY_PARAMS=member_name,gym_name,expiry_date,payment_upi_id
META_APP_ID=1711816793132513
META_CONFIG_ID=107597391155167

# ─── Redis & Rate Limiting ────────────────────────────────────────────────────
# Redis connection URL for Flask-Limiter and cache coordination
# Local dev fallback: memory://
REDIS_URL=redis://localhost:6379/0

# ─── Sentry Error Monitoring ──────────────────────────────────────────────────
# Leave blank to disable Sentry error reporting
SENTRY_DSN=

# ─── Admin & Owner Bootstrap ──────────────────────────────────────────────────
# Initial super-administrator created automatically on first run
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-to-a-strong-password

# Password for demo gym owner accounts (required if running seed scripts)
DEMO_OWNER_PASSWORD=change-me-to-a-strong-password

# ─── Production Gunicorn Tuning ───────────────────────────────────────────────
GUNICORN_MAX_REQUESTS=2000
GUNICORN_MAX_REQUESTS_JITTER=200

# ─── Mobile REST API & JWT Authentication ─────────────────────────────────────
# Master toggle for /api/mobile/v1 routes
MOBILE_API_ENABLED=true

# 64-character secret key used exclusively for signing mobile JWT access/refresh tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MOBILE_API_TOKEN_SECRET=change-me-to-a-secure-mobile-api-secret

# Mobile token validity durations
MOBILE_API_ACCESS_TOKEN_MINUTES=15
MOBILE_API_REFRESH_TOKEN_DAYS=30

# ─── Google OAuth (Mobile Sign-In) ────────────────────────────────────────────
# Google Web / Server Client ID used by the backend to verify mobile Google ID tokens
GOOGLE_OAUTH_CLIENT_ID=126496413976-4clljk154ngoiofoelvuglvm214gibqe.apps.googleusercontent.com
GOOGLE_OAUTH_ANDROID_CLIENT_ID=126496413976-0fiqve1n9eacie14ktam8vbviqt6447g.apps.googleusercontent.com

# ─── Google Play Billing & Real-Time Developer Notifications (RTDN) ───────────
# Application package identifier
GOOGLE_PLAY_PACKAGE_NAME=online.revorax.renewaldesk

# Google Cloud Service Account JSON content with Android Publisher API permissions
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# In-App Subscription catalog definition (JSON string)
GOOGLE_PLAY_CATALOG_JSON=

# 32-character AES encryption key for purchase token encryption at rest
GOOGLE_PLAY_TOKEN_ENCRYPTION_KEY=

# Google Cloud Pub/Sub RTDN topic audience and service account email
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# ─── WhatsApp AI Receptionist & OpenRouter ────────────────────────────────────
# Master toggle for automated AI bot handling on WhatsApp conversations
BOT_AI_ENABLED=true

# AI Provider: 'openrouter'
BOT_AI_PROVIDER=openrouter
BOT_AI_BASE_URL=https://openrouter.ai/api/v1
BOT_AI_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Multi-tier AI models with automatic fallback
BOT_AI_MODEL_PRIMARY=meta-llama/llama-3.3-70b-instruct:free
BOT_AI_MODEL_FALLBACK_1=google/gemini-2.0-flash-001
BOT_AI_MODEL_FALLBACK_2=mistralai/mistral-7b-instruct:free

BOT_AI_TIMEOUT_SECONDS=10
BOT_AI_MAX_TOKENS=450

# ─── AI Document Scanner & Vision ─────────────────────────────────────────────
# OpenRouter API key for multimodal document / ID card scanning (can reuse BOT_AI_API_KEY)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_VISION_MODEL_PRIMARY=google/gemini-2.0-flash-001
OPENROUTER_VISION_MODEL_FALLBACK=qwen/qwen-2.5-vl-72b-instruct:free

DOCUMENT_SCAN_MAX_IMAGES=5
DOCUMENT_SCAN_MAX_IMAGE_SIZE_MB=5
DOCUMENT_SCAN_TIMEOUT_SECONDS=25
